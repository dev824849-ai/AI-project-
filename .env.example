# POLARIS Environment Configuration
PROJECT_NAME="POLARIS – Intelligent Remote Antarctic Station Management Platform"
SECRET_KEY=replace-with-your-own-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (SQLite default for zero-config local run, or PostgreSQL)
DATABASE_URL=sqlite:///./polaris.db
# DATABASE_URL=postgresql://polaris_user:polaris_pass@localhost:5432/polaris_antarctic

# CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Frontend Vite variables
VITE_API_URL=http://localhost:8000/api
VITE_WS_URL=ws://localhost:8000/ws/telemetry
